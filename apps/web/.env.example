# Where the browser reaches soumetsu-api. Empty means the same origin (production routes /api through nginx).
PUBLIC_API_URL=http://localhost:8000
PUBLIC_HCAPTCHA_SITE_KEY=
PUBLIC_DISCORD_CLIENT_ID=
# The lazer server, for replay downloads on score pages. Empty hides the button.
PUBLIC_LAZER_URL=

# Server layer (src/routes/site-api)
API_URL=http://localhost:8000
DATABASE_URL=mysql://user:password@localhost:3306/ripple
REDIS_URL=redis://localhost:6379/0
APP_BASE_URL=http://localhost:5173
HCAPTCHA_SECRET_KEY=
BREVO_API_KEY=
BREVO_FROM="RealistikOsu" <noreply@ussr.pl>
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
TWITCH_APP_CLIENT_ID=
TWITCH_APP_CLIENT_SECRET=
PAYPAL_EMAIL_ADDRESS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FREEKASSA_MERCHANT_ID=
FREEKASSA_SECRET_WORD_1=
FREEKASSA_SECRET_WORD_2=
# The browser calls the mirror directly (it allows cross-origin requests); the server uses MIRROR_URL.
PUBLIC_MIRROR_URL=https://mirror.ussr.pl
MIRROR_URL=https://mirror.ussr.pl
# Set to true only behind a proxy that overwrites X-Real-IP.
TRUST_PROXY=false
DOCS_PATH=../../website-docs

# Admin panel
BANCHO_URL=https://c.ussr.pl
SCORE_SERVICE_URL=https://osu.ussr.pl/web
PERFORMANCE_URL=https://performance.ussr.pl
ADMIN_LOG_WEBHOOK_URL=
REPORT_WEBHOOK_URL=
RANKED_WEBHOOK_URL=
DONOR_BADGE_ID=1002
SERVER_NAME=RealistikOsu!
