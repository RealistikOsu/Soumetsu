{
  "name": "@soumetsu/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "Aochi <me@aochi.uk>",
  "scripts": {
    "dev": "vite dev",
    "build": "prisma generate && vite build",
    "start": "bun ./build/index.js",
    "check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "API_URL=http://localhost APP_BASE_URL=http://localhost DATABASE_URL=mysql://localhost/test REDIS_URL=redis://localhost bun test --preload ./test/preload.ts src",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@inlang/paraglide-js": "2.25.4",
    "@inlang/plugin-message-format": "4.4.4",
    "@sveltejs/kit": "2",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/qrcode": "^1.5.6",
    "prisma": "7.10.0",
    "svelte": "5.57.1",
    "svelte-adapter-bun": "1.0.1",
    "svelte-check": "4.7.6",
    "typescript": "5",
    "vite": "8.3.2"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "@soumetsu/ui": "workspace:*",
    "bcryptjs": "3.0.3",
    "dompurify": "3.4.16",
    "ioredis": "6.0.0",
    "marked": "18.0.14",
    "marked-footnote": "1.4.0",
    "qrcode": "^1.5.4",
    "stripe": "23.0.0"
  }
}
