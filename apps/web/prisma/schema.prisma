model badges {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(21485)
  icon String @db.VarChar(32)
}

model ban_logs {
  id      Int      @id @default(autoincrement())
  from_id Int
  to_id   Int
  ts      DateTime @default(now()) @db.DateTime(0)
  summary String   @db.VarChar(256)
  detail  String   @db.VarChar(2048)

  @@index([to_id], map: "to_id")
}

model bancho_settings {
  id           Int    @id @default(autoincrement())
  name         String @db.VarChar(32)
  value_int    Int    @default(0)
  value_string String @db.VarChar(512)

  @@index([name], map: "name")
}

model clans {
  id          Int    @id @default(autoincrement())
