  "ranked_maps": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} map",
        "countPlural=other": "{count} map"
      }
    }
  ],
  "ranked_players": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} játékos",
        "countPlural=other": "{count} játékos"
      }
    }
  ]
